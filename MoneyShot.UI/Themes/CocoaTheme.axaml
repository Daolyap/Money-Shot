<!--
    CocoaTheme.axaml — Avalonia port of MoneyShot/Themes/CocoaTheme.xaml (WPF). See LINUX_PORT.md
    Phase 1.

    Porting strategy, deliberately different per control:
      • Button variants, icon Paths, CheckBox, RadioButton, and Border/Card have NO required named
        template parts in Avalonia's own implementation (confirmed against Avalonia's Fluent theme
        source before writing this) — full custom ControlTheme, applied per-instance via
        Theme="{StaticResource X}" (Avalonia's equivalent of WPF's Style="{StaticResource X}" for a
        keyed, template-overriding style).
      • TextBox, ComboBox (+ ComboBoxItem), Slider, ScrollBar, and MenuItem/ContextMenu DO have
        required named parts wired to real behavior (PART_TextPresenter, PART_Track, popup
        placement, etc.) — reimplementing those templates by hand risks a control that LOOKS
        right but doesn't function (e.g. a Slider whose thumb doesn't drag). These are re-colored
        instead, by overriding the DynamicResource brush keys Avalonia's own Fluent templates
        already consume, leaving the actual template/behavior untouched.
      • RequestedThemeVariant="Dark" in App.axaml gives every control a sensible dark baseline
        before any override here — nothing here needs to build a look from scratch.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════ Palette ═══════════════════════════ -->

    <Color x:Key="Cocoa.WindowColor">#221A13</Color>
    <Color x:Key="Cocoa.TitleBarColor">#2A2018</Color>
    <Color x:Key="Cocoa.SurfaceColor">#2E241A</Color>
    <Color x:Key="Cocoa.SurfaceAltColor">#3A2D20</Color>
    <Color x:Key="Cocoa.HoverColor">#46382A</Color>
    <Color x:Key="Cocoa.PressedColor">#534333</Color>
    <Color x:Key="Cocoa.BorderColor">#4C3C2B</Color>
    <Color x:Key="Cocoa.BorderSubtleColor">#3A2E22</Color>
    <Color x:Key="Cocoa.AccentColor">#C28E5C</Color>
    <Color x:Key="Cocoa.AccentHoverColor">#D2A06E</Color>
    <Color x:Key="Cocoa.AccentPressedColor">#AD7C4D</Color>
    <Color x:Key="Cocoa.AccentSoftColor">#403122</Color>
    <Color x:Key="Cocoa.OnAccentColor">#271C11</Color>
    <Color x:Key="Cocoa.TextColor">#F1E9DE</Color>
    <Color x:Key="Cocoa.TextSecondaryColor">#C8B69E</Color>
    <Color x:Key="Cocoa.TextMutedColor">#97846C</Color>
    <Color x:Key="Cocoa.DangerColor">#C75048</Color>
    <Color x:Key="Cocoa.CanvasColor">#191209</Color>

    <SolidColorBrush x:Key="Cocoa.WindowBrush"        Color="{StaticResource Cocoa.WindowColor}"/>
    <SolidColorBrush x:Key="Cocoa.TitleBarBrush"      Color="{StaticResource Cocoa.TitleBarColor}"/>
    <SolidColorBrush x:Key="Cocoa.SurfaceBrush"       Color="{StaticResource Cocoa.SurfaceColor}"/>
    <SolidColorBrush x:Key="Cocoa.SurfaceAltBrush"    Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="Cocoa.HoverBrush"         Color="{StaticResource Cocoa.HoverColor}"/>
    <SolidColorBrush x:Key="Cocoa.PressedBrush"       Color="{StaticResource Cocoa.PressedColor}"/>
    <SolidColorBrush x:Key="Cocoa.BorderBrush"        Color="{StaticResource Cocoa.BorderColor}"/>
    <SolidColorBrush x:Key="Cocoa.BorderSubtleBrush"  Color="{StaticResource Cocoa.BorderSubtleColor}"/>
    <SolidColorBrush x:Key="Cocoa.AccentBrush"        Color="{StaticResource Cocoa.AccentColor}"/>
    <SolidColorBrush x:Key="Cocoa.AccentHoverBrush"   Color="{StaticResource Cocoa.AccentHoverColor}"/>
    <SolidColorBrush x:Key="Cocoa.AccentPressedBrush" Color="{StaticResource Cocoa.AccentPressedColor}"/>
    <SolidColorBrush x:Key="Cocoa.AccentSoftBrush"    Color="{StaticResource Cocoa.AccentSoftColor}"/>
    <SolidColorBrush x:Key="Cocoa.OnAccentBrush"      Color="{StaticResource Cocoa.OnAccentColor}"/>
    <SolidColorBrush x:Key="Cocoa.TextBrush"          Color="{StaticResource Cocoa.TextColor}"/>
    <SolidColorBrush x:Key="Cocoa.TextSecondaryBrush" Color="{StaticResource Cocoa.TextSecondaryColor}"/>
    <SolidColorBrush x:Key="Cocoa.TextMutedBrush"     Color="{StaticResource Cocoa.TextMutedColor}"/>
    <SolidColorBrush x:Key="Cocoa.DangerBrush"        Color="{StaticResource Cocoa.DangerColor}"/>
    <SolidColorBrush x:Key="Cocoa.CanvasBrush"        Color="{StaticResource Cocoa.CanvasColor}"/>

    <!-- ═══════════════════════════ Icon geometries (20×20 grid) ═══════════════════════════ -->

    <StreamGeometry x:Key="Icon.Cursor">M5,2 L5,15 L8.2,12.2 L10.4,17 L12.6,16 L10.4,11.4 L14.6,11.4 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Crop">M5.5,1.5 V14.5 H18.5 M1.5,5.5 H14.5 V18.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Rectangle">M2.5,4.5 H17.5 V15.5 H2.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Ellipse">M10,4.5 A7.5,5.5 0 1 0 10,15.5 A7.5,5.5 0 1 0 10,4.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Arrow">M4,16 L15,5 M15,5 H9 M15,5 V11</StreamGeometry>
    <StreamGeometry x:Key="Icon.Line">M3.5,16.5 L16.5,3.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Freehand">M3,15 C5,7 7,17 10,10 C12,5.5 14,8 17,4.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Number">M7.5,3.5 L6,16.5 M13.5,3.5 L12,16.5 M4,7.5 H16.5 M3.5,12.5 H16</StreamGeometry>
    <StreamGeometry x:Key="Icon.Text">M4,5.5 V3.5 H16 V5.5 M10,3.5 V16.5 M8,16.5 H12</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pixelate">M3,3 H8 V8 H3 Z M8,8 H13 V13 H8 Z M13,3 H18 V8 H13 Z M3,13 H8 V18 H3 Z M13,13 H18 V18 H13 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Undo">M4,8 H12.5 A4.5,4.5 0 0 1 12.5,17 H7 M7.5,4.5 L4,8 L7.5,11.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Refresh">M16.5,10 A6.5,6.5 0 1 1 13.2,4.35 M13.2,1.2 V4.7 H16.7</StreamGeometry>
    <StreamGeometry x:Key="Icon.ZoomIn">M8.5,3 A5.5,5.5 0 1 0 8.5,14 A5.5,5.5 0 1 0 8.5,3 M12.7,12.7 L17,17 M8.5,6 V11 M6,8.5 H11</StreamGeometry>
    <StreamGeometry x:Key="Icon.ZoomOut">M8.5,3 A5.5,5.5 0 1 0 8.5,14 A5.5,5.5 0 1 0 8.5,3 M12.7,12.7 L17,17 M6,8.5 H11</StreamGeometry>
    <StreamGeometry x:Key="Icon.ZoomReset">M8.5,3 A5.5,5.5 0 1 0 8.5,14 A5.5,5.5 0 1 0 8.5,3 M12.7,12.7 L17,17</StreamGeometry>
    <StreamGeometry x:Key="Icon.Save">M3.5,3.5 H13.5 L16.5,6.5 V16.5 H3.5 Z M6.5,3.5 V7.5 H12.5 V3.5 M5.5,16.5 V11.5 H14.5 V16.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Copy">M7.5,5.5 V2.5 H17.5 V12.5 H14.5 M2.5,5.5 H12.5 V17.5 H2.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Camera">M3.5,6.5 H6.5 L8,4.5 H12 L13.5,6.5 H16.5 V15.5 H3.5 Z M10,8.5 A2.6,2.6 0 1 0 10,13.7 A2.6,2.6 0 1 0 10,8.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Region">M3.5,6.5 V3.5 H6.5 M13.5,3.5 H16.5 V6.5 M16.5,13.5 V16.5 H13.5 M6.5,16.5 H3.5 V13.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Monitor">M2.5,3.5 H17.5 V13.5 H2.5 Z M7,16.5 H13 M10,13.5 V16.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.History">M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M10,6 V10 L13,12</StreamGeometry>
    <StreamGeometry x:Key="Icon.Folder">M2.5,4.5 H8 L9.5,6.5 H17.5 V15.5 H2.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Settings">M3,5.5 H17 M3,10 H17 M3,14.5 H17 M7,3.5 V7.5 M13,8 V12 M5.5,12.5 V16.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Info">M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M10,9 V13.5 M10,6.4 V6.9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Help">M6.5,7 A3.5,3.5 0 1 1 10,10.5 V12.5 M10,15.4 V15.9</StreamGeometry>

    <!-- Window caption glyphs (10×10 grid) -->
    <StreamGeometry x:Key="Icon.WindowMinimize">M0,5 H10</StreamGeometry>
    <StreamGeometry x:Key="Icon.WindowMaximize">M0.5,0.5 H9.5 V9.5 H0.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.WindowRestore">M2.5,2.5 V0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.WindowClose">M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5</StreamGeometry>

    <!-- Stroke-rendered icon inside a button. Stroke follows the nearest ContentControl ancestor's
         Foreground so icons recolor automatically on hover/active/disabled state changes, matching
         the WPF version's RelativeSource AncestorType binding. -->
    <ControlTheme x:Key="ToolIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding $parent[ContentControl].Foreground}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </ControlTheme>

    <!-- Fill-rendered variant for solid glyphs (cursor pointer, pixelate blocks). -->
    <ControlTheme x:Key="ToolIconFilled" TargetType="Path" BasedOn="{StaticResource ToolIcon}">
        <Setter Property="Stroke" Value="{x:Null}"/>
        <Setter Property="Fill" Value="{Binding $parent[ContentControl].Foreground}"/>
    </ControlTheme>

    <!-- Caption glyph inside title-bar buttons. -->
    <ControlTheme x:Key="CaptionIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </ControlTheme>

    <!-- ═══════════════════════════ Buttons ═══════════════════════════ -->

    <!-- Quiet toolbar / utility button: transparent until hovered. -->
    <ControlTheme x:Key="ToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Cocoa.TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource Cocoa.HoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Cocoa.TextBrush}"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{StaticResource Cocoa.PressedBrush}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource Cocoa.TextMutedBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </ControlTheme>

    <!-- Active (selected) tool: caramel outline + warm fill so the current tool is obvious. -->
    <ControlTheme x:Key="ToolButtonActive" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{StaticResource Cocoa.AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Cocoa.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cocoa.AccentBrush}"/>
    </ControlTheme>

    <!-- Bordered secondary button (dialogs, settings). -->
    <ControlTheme x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{StaticResource Cocoa.SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cocoa.BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Cocoa.TextBrush}"/>
    </ControlTheme>

    <!-- Primary call-to-action: caramel accent with dark text. -->
    <ControlTheme x:Key="AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Cocoa.AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Cocoa.OnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource Cocoa.AccentHoverBrush}"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{StaticResource Cocoa.AccentPressedBrush}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </ControlTheme>

    <!-- Title-bar caption buttons. -->
    <ControlTheme x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Cocoa.TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource Cocoa.HoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Cocoa.TextBrush}"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{StaticResource Cocoa.PressedBrush}"/>
        </Style>
    </ControlTheme>

    <!-- Close button hovers red, matching Windows convention. -->
    <ControlTheme x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="#B02315"/>
        </Style>
    </ControlTheme>

    <!-- Round colour swatch for the annotation palette. The colour lives in Background so
         code-behind (ColorButton_Click) can read it back as a SolidColorBrush. -->
    <ControlTheme x:Key="ColorSwatch" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cocoa.BorderBrush}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Cocoa.TextBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </ControlTheme>

    <!-- ═══════════════════════════ Inputs (behavior-driven — recolor Fluent's own template
         via resource keys rather than replacing PART_-named internals) ═══════════════════════ -->

    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource Cocoa.TextColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource Cocoa.TextColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource Cocoa.TextColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource Cocoa.BorderColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource Cocoa.AccentColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource Cocoa.AccentColor}"/>
    <Color x:Key="TextControlSelectionHighlightColor">#66C28E5C</Color>

    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource Cocoa.HoverColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource Cocoa.PressedColor}"/>
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource Cocoa.TextColor}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource Cocoa.TextColor}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{StaticResource Cocoa.TextColor}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource Cocoa.BorderColor}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource Cocoa.AccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{StaticResource Cocoa.AccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{StaticResource Cocoa.BorderColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Cocoa.SurfaceColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource Cocoa.BorderColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource Cocoa.TextSecondaryColor}"/>

    <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource Cocoa.AccentColor}"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource Cocoa.AccentHoverColor}"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource Cocoa.AccentPressedColor}"/>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource Cocoa.AccentColor}"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource Cocoa.AccentHoverColor}"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource Cocoa.AccentPressedColor}"/>

    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource Cocoa.TextMutedColor}"/>
    <Color x:Key="ScrollBarThumbBackgroundColor">#4C3C2B</Color>

    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource Cocoa.SurfaceColor}"/>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource Cocoa.BorderColor}"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource Cocoa.HoverColor}"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource Cocoa.TextColor}"/>

    <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource Cocoa.SurfaceAltColor}"/>
    <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource Cocoa.TextColor}"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource Cocoa.BorderColor}"/>

    <!-- ═══════════════════════════ CheckBox / RadioButton (no required named parts —
         safe to fully custom-template) ═══════════════════════════ -->

    <ControlTheme x:Key="CocoaCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Cocoa.TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <Border Name="Box" Width="17" Height="17" CornerRadius="4"
                            Background="{StaticResource Cocoa.SurfaceAltBrush}"
                            BorderBrush="{StaticResource Cocoa.BorderBrush}"
                            BorderThickness="1.5"
                            VerticalAlignment="Center">
                        <Path Name="Check" Data="M3,8.5 L6.5,12 L13,4.5"
                              Stroke="{StaticResource Cocoa.OnAccentBrush}" StrokeThickness="2"
                              Width="14" Height="14" Stretch="Uniform" IsVisible="False"/>
                    </Border>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Box">
            <Setter Property="Background" Value="{StaticResource Cocoa.AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Cocoa.AccentBrush}"/>
        </Style>
        <Style Selector="^:checked /template/ Path#Check">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{StaticResource Cocoa.AccentBrush}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="CocoaRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Cocoa.TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <Border Name="Outer" Width="17" Height="17" CornerRadius="9"
                            Background="{StaticResource Cocoa.SurfaceAltBrush}"
                            BorderBrush="{StaticResource Cocoa.BorderBrush}"
                            BorderThickness="1.5"
                            VerticalAlignment="Center">
                        <Ellipse Name="Dot" Width="7" Height="7"
                                 Fill="{StaticResource Cocoa.AccentBrush}" IsVisible="False"/>
                    </Border>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Outer">
            <Setter Property="BorderBrush" Value="{StaticResource Cocoa.AccentBrush}"/>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Dot">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Outer">
            <Setter Property="BorderBrush" Value="{StaticResource Cocoa.AccentBrush}"/>
        </Style>
    </ControlTheme>

    <!-- ═══════════════════════════ Chrome bits ═══════════════════════════ -->

    <!-- Thin vertical divider between toolbar groups. -->
    <ControlTheme x:Key="ToolbarDivider" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="9,4"/>
        <Setter Property="Fill" Value="{StaticResource Cocoa.BorderSubtleBrush}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </ControlTheme>

    <!-- Card container used for grouped content (settings sections, main-window panels). No
         required parts (Border isn't a templated control) — plain property setters. -->
    <ControlTheme x:Key="CocoaCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Cocoa.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cocoa.BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20"/>
    </ControlTheme>

</ResourceDictionary>
